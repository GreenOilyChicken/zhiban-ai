/**app.wxss**/
/* 全局样式 — 适老化大字体设计 */

page {
  font-size: 36rpx;
  color: #333;
  background-color: #F5F5F5;
  line-height: 1.6;
}

/* 适老化大字体模式 */
.elderly-mode {
  font-size: 44rpx;
}

.elderly-mode .card-title {
  font-size: 48rpx;
}

/* 卡片容器 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

.card-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.card-content {
  font-size: 36rpx;
  color: #666;
  line-height: 1.8;
}

/* 按钮 */
.btn-primary {
  background: #4A90D9;
  color: #fff;
  border-radius: 12rpx;
  padding: 24rpx 40rpx;
  font-size: 40rpx;
  text-align: center;
  border: none;
}

.btn-primary[disabled] {
  background: #ccc;
}

.btn-large {
  padding: 32rpx 48rpx;
  font-size: 48rpx;
}

/* Tab导航 */
.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 2rpx solid #eee;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 36rpx;
  color: #999;
}

.tab-item.active {
  color: #4A90D9;
  font-weight: bold;
  border-bottom: 4rpx solid #4A90D9;
}

/* 输入框 */
.input-box {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin: 20rpx;
  font-size: 40rpx;
}

/* 消息气泡 */
.msg-bubble {
  max-width: 80%;
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  margin: 16rpx;
  font-size: 38rpx;
  line-height: 1.6;
}

.msg-bubble.user {
  background: #4A90D9;
  color: #fff;
  margin-left: auto;
}

.msg-bubble.bot {
  background: #fff;
  color: #333;
}

/* 紧急提示 */
.emergency-box {
  background: #FFF3E0;
  border: 4rpx solid #FF9800;
  border-radius: 12rpx;
  padding: 24rpx;
  margin: 20rpx;
}

.emergency-text {
  color: #E65100;
  font-size: 40rpx;
  font-weight: bold;
}
