.container {
  padding: 0 0 40rpx;
}

.greeting-card {
  background: linear-gradient(135deg, #4A90D9, #5BA3F0);
  color: #fff;
}

.greeting-card .card-title,
.greeting-card .card-content {
  color: #fff;
}

.section-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin: 30rpx 20rpx 10rpx;
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.quick-item {
  width: 48%;
  text-align: center;
}

.quick-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.quick-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.quick-desc {
  font-size: 28rpx;
  color: #999;
}

.chat-entry {
  display: flex;
  align-items: center;
}

.chat-icon {
  font-size: 64rpx;
  margin-right: 24rpx;
}

.chat-text {
  flex: 1;
}

.chat-arrow {
  font-size: 56rpx;
  color: #ccc;
}
