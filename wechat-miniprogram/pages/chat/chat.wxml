<view class="container {{elderlyMode ? 'elderly-mode' : ''}}">
  <!-- 智能体切换（附件一 §3.4：切换康养/政务/文旅智能体）-->
  <view class="agent-bar">
    <view
      wx:for="{{agents}}"
      wx:key="key"
      class="agent-chip {{agentType === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onSwitchAgent"
    >{{item.name}}</view>
  </view>

  <!-- 弱网/离线提示条（附件一 §5.2：弱网环境下友好提示）-->
  <view wx:if="{{offlineNotice}}" class="offline-bar" bindtap="onRetryNetwork">
    <text>⚠️ {{offlineNotice}}（点击重试）</text>
  </view>

  <!-- 消息列表 -->
  <scroll-view scroll-y class="msg-list" scroll-into-view="msg-{{messages.length}}">
    <block wx:for="{{messages}}" wx:key="index">
      <view id="msg-{{index + 1}}" class="msg-row {{item.role === 'user' ? 'msg-user' : 'msg-bot'}}">
        <view class="msg-avatar">{{item.role === 'user' ? '👤' : '🤖'}}</view>
        <view class="msg-bubble {{item.role === 'user' ? 'user' : 'bot'}}">
          <text>{{item.content}}</text>
        </view>
      </view>
    </block>

    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="msg-row msg-bot">
      <view class="msg-avatar">🤖</view>
      <view class="msg-bubble bot loading-bubble">
        <text>正在思考中...</text>
      </view>
    </view>
  </scroll-view>

  <!-- 底部输入区 -->
  <view class="input-area">
    <view class="input-left">
      <input
        class="input-box"
        placeholder="{{online ? '请输入您的问题' : '当前离线，可查看本地缓存对话'}}"
        value="{{inputText}}"
        disabled="{{!online}}"
        bindinput="onInput"
        bindconfirm="onSend"
        confirm-type="send"
      />
    </view>
    <button class="btn-primary btn-send" bindtap="onSend" disabled="{{loading || !online}}">{{online ? '发送' : '离线'}}</button>
  </view>

  <!-- 功能栏：语音输入 / 语音播报 / 清空 -->
  <view class="toolbar">
    <view class="tool-btn" bindtap="onVoiceInput">🎤 {{recording ? '停止' : '语音输入'}}</view>
    <view class="tool-btn" bindtap="onToggleSpeak">{{speakEnabled ? '🔊 播报开' : '🔇 播报关'}}</view>
    <view class="tool-btn" bindtap="onClearChat">🗑 清空</view>
  </view>
</view>
