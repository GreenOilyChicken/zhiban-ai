.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.msg-list {
  flex: 1;
  padding: 20rpx;
  padding-bottom: 200rpx;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.msg-user {
  flex-direction: row-reverse;
}

.msg-avatar {
  font-size: 48rpx;
  margin: 0 16rpx;
}

.msg-bubble {
  max-width: 75%;
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  font-size: 38rpx;
  line-height: 1.6;
}

.msg-bubble.user {
  background: #4A90D9;
  color: #fff;
}

.msg-bubble.bot {
  background: #fff;
  color: #333;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.loading-bubble {
  color: #999;
}

.input-area {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fff;
  border-top: 2rpx solid #eee;
}

.input-left {
  flex: 1;
}

.input-box {
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 40rpx;
  width: 100%;
  box-sizing: border-box;
}

.btn-send {
  margin-left: 16rpx;
  padding: 20rpx 40rpx;
  font-size: 36rpx;
  white-space: nowrap;
}

.toolbar {
  display: flex;
  justify-content: space-around;
  padding: 16rpx;
  background: #fff;
  border-top: 2rpx solid #eee;
}

.tool-btn {
  /* 附件一 §5.2：适老化，字号不小于 32rpx（≈16px） */
  font-size: 34rpx;
  color: #4A90D9;
  padding: 8rpx 32rpx;
}

/* 弱网/离线提示条（附件一 §5.2）*/
.offline-bar {
  background: #FFF4E5;
  color: #B25E00;
  border-bottom: 2rpx solid #FFD8A8;
  padding: 18rpx 24rpx;
  font-size: 34rpx;
  text-align: center;
}

.elderly-mode .offline-bar {
  font-size: 38rpx;
}

.btn-send[disabled] {
  background: #C8C8C8;
  color: #fff;
}

/* 智能体切换栏（附件一 §3.4）*/
.agent-bar {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  border-bottom: 2rpx solid #eee;
}

.agent-chip {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  padding: 16rpx 0;
  border-radius: 40rpx;
  background: #F5F5F5;
  color: #666;
}

.agent-chip.active {
  background: #4A90D9;
  color: #fff;
  font-weight: 600;
}

/* 大字模式：进一步放大（适老化）*/
.elderly-mode .msg-bubble {
  font-size: 42rpx;
}

.elderly-mode .input-box {
  font-size: 44rpx;
}

.elderly-mode .tool-btn,
.elderly-mode .agent-chip {
  font-size: 38rpx;
}
