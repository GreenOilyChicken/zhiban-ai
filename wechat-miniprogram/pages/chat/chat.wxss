.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.msg-list {
  flex: 1;
  padding: 20rpx;
  padding-bottom: 200rpx;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.msg-user {
  flex-direction: row-reverse;
}

.msg-avatar {
  font-size: 48rpx;
  margin: 0 16rpx;
}

.msg-bubble {
  max-width: 75%;
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  font-size: 38rpx;
  line-height: 1.6;
}

.msg-bubble.user {
  background: #4A90D9;
  color: #fff;
}

.msg-bubble.bot {
  background: #fff;
  color: #333;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.loading-bubble {
  color: #999;
}

.input-area {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fff;
  border-top: 2rpx solid #eee;
}

.input-left {
  flex: 1;
}

.input-box {
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 40rpx;
  width: 100%;
  box-sizing: border-box;
}

.btn-send {
  margin-left: 16rpx;
  padding: 20rpx 40rpx;
  font-size: 36rpx;
  white-space: nowrap;
}

.toolbar {
  display: flex;
  justify-content: space-around;
  padding: 16rpx;
  background: #fff;
  border-top: 2rpx solid #eee;
}

.tool-btn {
  font-size: 32rpx;
  color: #4A90D9;
  padding: 8rpx 32rpx;
}
