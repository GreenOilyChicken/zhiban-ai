.container { padding: 20rpx 0 40rpx; }

.detail-card { margin: 20rpx; padding: 32rpx; }

.detail-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.detail-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.meta-item { font-size: 34rpx; color: #666; }

.detail-section { margin-bottom: 28rpx; }

.section-label {
  font-size: 36rpx;
  font-weight: bold;
  color: #4A90D9;
  margin-bottom: 12rpx;
}

.section-body {
  font-size: 38rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
}

.point-item {
  font-size: 36rpx;
  color: #444;
  line-height: 1.8;
}

.source-note {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #eee;
  font-size: 32rpx;
  color: #999;
}

.ask-btn { margin: 20rpx 32rpx; }

.loading-state, .empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #999;
  font-size: 36rpx;
}

.empty-icon { font-size: 96rpx; margin-bottom: 20rpx; }
