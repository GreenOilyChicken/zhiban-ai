<view class="container {{elderlyMode ? 'elderly-mode' : ''}}">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="avatar">👤</view>
    <view class="user-info">
      <view wx:if="{{userInfo}}" class="user-name">{{userInfo.username || '用户'}}</view>
      <view wx:else class="user-name" bindtap="onLogin">点击登录</view>
      <view class="user-desc">小芯AI陪伴您</view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-list card">
    <block wx:for="{{menuItems}}" wx:key="id">
      <view class="menu-item" bindtap="onMenuTap" data-id="{{item.id}}">
        <view class="menu-icon">{{item.icon}}</view>
        <view class="menu-title">{{item.title}}</view>
        <view class="menu-arrow">›</view>
      </view>
    </block>
  </view>

  <!-- 紧急联系 -->
  <view class="emergency-section card">
    <view class="card-title">紧急联系</view>
    <view class="emergency-list">
      <view class="emergency-item" bindtap="onCallEmergency" data-phone="120">
        <text class="emergency-number">120</text>
        <text class="emergency-label">急救</text>
      </view>
      <view class="emergency-item" bindtap="onCallEmergency" data-phone="400-161-9995">
        <text class="emergency-number">400-161-9995</text>
        <text class="emergency-label">心理援助</text>
      </view>
      <view class="emergency-item" bindtap="onCallEmergency" data-phone="12393">
        <text class="emergency-number">12393</text>
        <text class="emergency-label">医保热线</text>
      </view>
    </view>
  </view>
</view>
