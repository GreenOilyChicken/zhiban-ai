.container {
  padding-bottom: 40rpx;
}

.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #4A90D9, #5BA3F0);
  padding: 40rpx 32rpx;
  color: #fff;
}

.avatar {
  font-size: 80rpx;
  margin-right: 24rpx;
}

.user-name {
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.user-desc {
  font-size: 32rpx;
  opacity: 0.9;
}

.menu-list {
  margin-top: 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
}

.menu-title {
  flex: 1;
  font-size: 40rpx;
  color: #333;
}

.menu-arrow {
  font-size: 48rpx;
  color: #ccc;
}

.emergency-section {
  margin-top: 20rpx;
}

.emergency-list {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
}

.emergency-item {
  text-align: center;
}

.emergency-number {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #E65100;
}

.emergency-label {
  font-size: 32rpx;
  color: #999;
}
