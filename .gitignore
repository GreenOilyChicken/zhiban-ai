# ── 环境配置 ──────────────────
.env
.env.docker
*.env.local

# ── Python ───────────────────
python/__pycache__/
python/*.pyc
python/venv/
python/.venv/
python/knowledge_base/chroma_db/
python/output/
python/.pytest_cache/
python/*.egg-info/

# ── Java ─────────────────────
java-backend/target/
java-backend/.mvn/
java-backend/*.iml
java-backend/.idea/

# ── 前端 ─────────────────────
vue-frontend/node_modules/
vue-frontend/dist/
vue-frontend/.vite/

# ── IDE ──────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Docker ───────────────────
.env.docker

# ── TLS 证书（私钥绝不提交仓库）─────
# 仅忽略证书/私钥文件本身，certs/README.md 与 certs/.gitkeep 仍纳入版本控制
certs/*.key
certs/*.crt
certs/*.pem
certs/*.csr
certs/*.der
certs/*.p12
certs/*.pfx
certs/*.key.*
certs/*.crt.*

# ── 本地依赖目录（不提交）─────────
python/.pylibs/
.pip-install.log
python/knowledge_base/chroma_db/

# ── 本地构建工具 ──────────────────
.tools/
java-backend/src/test/resources/schema-h2.sql
vue-frontend/node_modules/
vue-frontend/dist/
.npmcache/
