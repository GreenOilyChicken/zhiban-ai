# ═══════════════════════════════════════════════════════
# 知伴AI Docker Compose 环境变量配置
# ═══════════════════════════════════════════════════════
# 使用方法：
#   1. 复制本文件为 .env.docker
#   2. 填写实际值（特别是 API Key 和密码）
#   3. 执行一键启动脚本或 docker compose --env-file .env.docker up -d
# ⚠️ 警告：.env.docker 包含敏感信息，请勿提交到版本控制系统
#
# 生成强随机值：
#   DB_PASSWORD / JWT_SECRET 可用以下命令生成：
#   openssl rand -base64 32
# ═══════════════════════════════════════════════════════

# ── MySQL 数据库 ──────────────────────────────────────
# MySQL root 用户密码（生产环境务必修改为强随机值）
DB_PASSWORD=CHANGE_ME_openssl_rand_base64_32

# ── JWT 配置 ──────────────────────────────────────────
# JWT 签名密钥（至少32字符，生产环境务必修改为强随机值）
# 注意：后端不提供默认值，未注入将启动失败（安全设计）
JWT_SECRET=CHANGE_ME_openssl_rand_base64_32

# ── LLM 大模型配置 ────────────────────────────────────
# 提供商: deepseek | openai | qwen | codebuddy(本地代理，仅开发)
LLM_PROVIDER=deepseek

# DeepSeek（推荐，性价比最高）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI（备选）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 通义千问（备选）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# CodeBuddy 本地代理（仅开发/联调使用，勿用于生产）
CODEBUDDY_API_KEY=
CODEBUDDY_BASE_URL=http://host.docker.internal:3800/v1
CODEBUDDY_MODEL=deepseek-v4-flash

# LLM 生成参数
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ── Embedding 模型 ────────────────────────────────────
# 生产：bge（中文语义检索）；离线兜底：hash（仅链路验证）
EMBEDDING_PROVIDER=bge
BGE_MODEL_NAME=BAAI/bge-small-zh-v1.5
# 运行设备：cpu 或 cuda（有 GPU 时改为 cuda 可加速）
EMBEDDING_DEVICE=cpu

# ── 语音（TTS/ASR）────────────────────────────────────
# 留空则使用内置通道（edge-tts / whisper）；配置后优先走阿里云 NLS
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_NLS_APP_KEY=
ALIYUN_NLS_TOKEN=
# ASR 本地模型规格：tiny / base / small / medium
ASR_MODEL=small

# ── RAG 服务认证（可选）──────────────────────────────
RAG_API_KEY=

# ── Java 后端 AI 服务地址 ─────────────────────────────
# Docker 内部网络使用服务名；本机开发用 http://localhost:8081
AI_SERVICE_URL=http://python-ai:8081

# ── 接口限流（附件一 §3.6）────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
