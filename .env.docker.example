# ═══════════════════════════════════════════════════════
# 知伴AI Docker Compose 环境变量配置
# ═══════════════════════════════════════════════════════
# 使用方法：
#   1. 复制本文件为 .env.docker
#   2. 填写实际值（特别是 API Key 和密码）
#   3. 执行一键启动脚本或 docker compose --env-file .env.docker up -d
# ⚠️ 警告：.env.docker 包含敏感信息，请勿提交到版本控制系统
# ═══════════════════════════════════════════════════════

# ── MySQL 数据库 ──────────────────────────────────────
# MySQL root 用户密码（生产环境务必修改）
DB_PASSWORD=zhiban123

# ── JWT 配置 ──────────────────────────────────────────
# JWT 签名密钥（至少32字符，生产环境务必修改为随机字符串）
JWT_SECRET=zhiban-ai-jwt-secret-key-change-in-production-32chars

# ── LLM 大模型配置 ────────────────────────────────────
# 提供商: deepseek | openai | qwen
LLM_PROVIDER=deepseek

# DeepSeek（推荐，性价比最高）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI（备选）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 通义千问（备选）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# LLM 生成参数
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ── Embedding 模型 ────────────────────────────────────
BGE_MODEL_NAME=BAAI/bge-small-zh-v1.5
# 运行设备：cpu 或 cuda（有 GPU 时改为 cuda 可加速）
EMBEDDING_DEVICE=cpu

# ── RAG 服务认证（可选）──────────────────────────────
RAG_API_KEY=
