# ═══════════════════════════════════════════════════════
# 知伴AI 环境变量配置
# ⚠️ 警告：此文件包含 API Key，不应提交到版本控制系统
# 请复制此文件为 .env 并填写实际值
# ═══════════════════════════════════════════════════════

# ── LLM 配置 ──────────────────────────────────────────
# Provider: deepseek | openai | qwen
LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI (备选)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 通义千问 (备选)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# LLM 参数
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ── Embedding 配置 ────────────────────────────────────
# EMBEDDING_PROVIDER: bge（中文语义检索，生产默认）/ hash（离线兜底，仅链路验证）
EMBEDDING_PROVIDER=bge
# 本地模型目录（默认 models/bge-small-zh-v1.5）。
# 客户环境无外网，请勿填 HuggingFace repo id，否则会尝试在线下载而失败。
BGE_MODEL_DIR=models/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu

# ── 知识库路径（建议使用绝对路径）──────────────────────
KB_POLICY_DIR=knowledge_base/policies
KB_ELDERLY_DIR=knowledge_base/elderly
KB_TOURISM_DIR=knowledge_base/tourism
KB_CHROMA_DIR=knowledge_base/chroma_db

# ── 台账输出 ──────────────────────────────────────────
LEDGER_OUTPUT_DIR=output/ledgers

# ── 日志脱敏 ──────────────────────────────────────────
LTC_LOG_MASK=true
